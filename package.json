{
  "name": "afk-pipeline",
  "version": "0.1.0",
  "description": "Automated multi-agent orchestration pipeline for PRD slices",
  "type": "module",
  "bin": {
    "afk": "./dist/afk.js",
    "afk-claude": "./dist/afk-claude.js",
    "afk-codex": "./dist/afk-codex.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "dev": "tsx src/afk.ts",
    "dev:claude": "tsx src/afk-claude.ts",
    "dev:codex": "tsx src/afk-codex.ts",
    "test": "pnpm run test:fast && pnpm run test:heavy:orchestrator && pnpm run test:heavy:wave && pnpm run test:heavy:resume && pnpm run test:heavy:qa && pnpm run test:heavy:clean",
    "test:fast": "vitest run --exclude \"src/{orchestrator,wave,resume-integration,qa-orchestration,clean-failed}.test.ts\" --exclude \"src/*.e2e.test.ts\"",
    "test:heavy": "vitest run src/orchestrator.test.ts src/wave.test.ts src/resume-integration.test.ts src/qa-orchestration.test.ts src/clean-failed.test.ts",
    "test:heavy:orchestrator": "vitest run src/orchestrator.test.ts",
    "test:heavy:wave": "vitest run src/wave.test.ts",
    "test:heavy:resume": "vitest run src/resume-integration.test.ts",
    "test:heavy:qa": "vitest run src/qa-orchestration.test.ts",
    "test:heavy:clean": "vitest run src/clean-failed.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist",
    "prompts",
    "agents"
  ],
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5.7",
    "vitest": "^3"
  },
  "engines": {
    "node": ">=22"
  }
}
